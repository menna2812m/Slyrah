# Copy to .env.local. Nothing here is secret — the storefront is a public
# client and must never hold an Admin credential.

# Canonical origin. Drives canonical URLs, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://slyrah.com

# Where the storefront reads commerce data from.
#
# Leave unset in development: it falls back to "/api", the bundled mock backend
# in src/app/api. Point it at the Admin Panel's public API to go live — no
# component changes are needed.
# NEXT_PUBLIC_API_BASE_URL=https://api.slyrah.com/storefront/v1
